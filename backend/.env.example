# Copy to backend/.env and enter values privately. Never put secrets in web/.env.
PORT=3001
# Web app address(es), comma separated. In development localhost, 127.0.0.1 and
# phones on the same Wi-Fi are always allowed.
ALLOWED_ORIGINS=http://localhost:8081
# Public address of this API in production (used in file and photo links),
# e.g. https://api.askprana.com. Leave empty for local development.
PUBLIC_API_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=askprana_dev
DB_USER=askprana_dev
DB_PASSWORD=<I will enter privately>
DB_CONNECTION_LIMIT=8
DB_CONNECT_TIMEOUT_MS=10000
# off locally; use verify-ca only with the provider CA configured by deployment.
DB_SSL=off
SESSION_SECRET=<at-least-32-random-characters>
REGISTRATION_SECRET=<at-least-32-random-characters>
# Same values as the Supabase function secrets.
OPENAI_API_KEY=
MSG91_AUTHKEY=
MSG91_WIDGET_ID=
GOOGLE_WEB_CLIENT_ID=
# Optional overrides. Leave empty to use the same models as before.
# REALTIME_VOICE_MODEL=
# REALTIME_VOICE_VOICE=
# ASK_PRANA_TRANSLATION_MODEL=
# Chat attachments, generated documents and profile photos are stored here.
UPLOAD_DIR=./uploads
