# Edge Function secrets. Copy to supabase/.env, fill in, then:
#   supabase secrets set --env-file supabase/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.)

# Ask Prana AI answers, voice transcription and read-aloud (OpenAI)
OPENAI_API_KEY=
# Optional: model used to translate chat history (defaults inside the code)
ASK_PRANA_TRANSLATION_MODEL=

# Phone + email OTP login (MSG91 OTP widget)
MSG91_AUTHKEY=
MSG91_WIDGET_ID=

# Google sign-in (OAuth 2.0 Web client id from Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=
